  <body>
    <div id="root"><header class="navbar"><a href="https://todo-listee.netlify.app/#home" class="logo">TaskFlow</a><nav><a href="https://todo-listee.netlify.app/#home">Home</a><a href="https://todo-listee.netlify.app/Tasks">My Tasks</a><a href="https://todo-listee.netlify.app/#features">Features</a></nav></header><section id="home" class="hero"><h1>Organize your day one task at a time</h1><p>Add tasks, track your progress and stay focused.</p><a href="https://todo-listee.netlify.app/#tasks" class="btn">Get Started</a></section><section id="tasks" class="section tasks"><h2>My tasks</h2><div class="stats"><div class="stat remaining"><strong>0</strong><span>Remaining</span></div><div class="stat paused"><strong>0</strong><span>Paused</span></div><div class="stat completed"><strong>0</strong><span>Completed</span></div></div><form class="task-form"><input placeholder="Add a new task..." type="text" value=""><input title="Deadline (optional)" type="datetime-local" value=""><button type="submit" class="btn">Add</button></form><div class="filters"><button class="filter active">all</button><button class="filter">remaining</button><button class="filter">paused</button><button class="filter">completed</button></div><ul class="task-list"><li class="empty">No tasks here yet.</li></ul></section><section id="features" class="section"><h2>Features</h2><div class="features-grid"><div class="card"><h3>Fast</h3><p>Add tasks in seconds.</p></div><div class="card"><h3>Filters</h3><p>See only what matters.</p></div><div class="card"><h3>Saved</h3><p>Your tasks stay after refresh.</p></div></div></section><footer class="footer"><p>© 2026 TaskFlow. All rights reserved.</p></footer></div>
  


